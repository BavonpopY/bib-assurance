# Example settings for running BIB Assurance locally.
# Set these as environment variables before "python manage.py runserver".
# Never commit a real .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

DB_NAME=bibdb
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
